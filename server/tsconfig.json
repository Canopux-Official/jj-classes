{
  "compilerOptions": {
    "outDir": "./dist",           // Output directory for compiled files
    "rootDir": "./src",              // Set root directory to the project root (outside src)
    "esModuleInterop": true,
    // "strict": true,
    "module": "commonjs",
    "target": "es6",
    "moduleResolution": "node",
    "isolatedModules": true,  // Add this
  },
  "include": [
    "src/server.ts",                // Include server.ts outside src
    "controllers/**/*.ts",
    "src/routes/**/*.ts",
    "src/models/**/*.ts",
    "middleware/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
